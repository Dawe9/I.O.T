rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["email", "role", "createdAt"])
        && request.resource.data.role == "user"
        && request.resource.data.email == request.auth.token.email;

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["cardUid", "cardStatus", "assignedAt"])
        && (
          (
            request.resource.data.cardUid is string
            && request.resource.data.cardUid.matches("^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$")
            && request.resource.data.cardStatus == "assigned"
            && request.resource.data.assignedAt is timestamp
          )
          || !request.resource.data.keys().hasAny(["cardUid", "cardStatus", "assignedAt"])
        );

      allow delete: if false;

      match /devices/{tokenId} {
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(["token", "updatedAt"])
          && request.resource.data.token == tokenId
          && request.resource.data.updatedAt == request.time;
        allow read: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /accessEvents/{eventId} {
      function validAccessEvent() {
        return request.resource.data.keys().hasOnly([
            "eventId", "timestamp", "uid", "status", "type"
          ])
          && request.resource.data.keys().hasAll([
            "eventId", "timestamp", "uid", "status", "type"
          ])
          && request.resource.data.eventId == eventId
          && eventId.matches("^[0-9A-F]{12}-[1-9][0-9]*$")
          && request.resource.data.timestamp is string
          && request.resource.data.timestamp.matches(
            "^(SIN_HORA_NTP|[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})$"
          )
          && request.resource.data.uid is string
          && (
            request.resource.data.uid == "-"
            || request.resource.data.uid.matches(
              "^([0-9A-F]{2}:){3}[0-9A-F]{2}$|^([0-9A-F]{2}:){6}[0-9A-F]{2}$|^([0-9A-F]{2}:){9}[0-9A-F]{2}$"
            )
          )
          && request.resource.data.type in ["ACCESO", "ALERTA"]
          && request.resource.data.status in [
            "AUTORIZADO", "DENEGADO", "REPORTE_ROBO", "AVISO_SEGURIDAD"
          ]
          && (
            (request.resource.data.type == "ACCESO"
              && request.resource.data.status in ["AUTORIZADO", "DENEGADO"])
            || (request.resource.data.type == "ALERTA"
              && request.resource.data.status in ["REPORTE_ROBO", "AVISO_SEGURIDAD"])
          );
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && validAccessEvent();
      allow update: if isAdmin() && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /managedCredentials/{credentialId} {
      function validCredential() {
        return request.resource.data.keys().hasOnly(["uid", "type", "status"])
          && request.resource.data.keys().hasAll(["uid", "type", "status"])
          && request.resource.data.type in ["CARD", "TOKEN"]
          && request.resource.data.status in ["AUTHORIZED", "UNAUTHORIZED"]
          && credentialId.matches(
            "^(CARD|TOKEN)_([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$"
          )
          && request.resource.data.uid is string
          && request.resource.data.uid.matches(
            "^([0-9A-F]{2}:){3}[0-9A-F]{2}$|^([0-9A-F]{2}:){6}[0-9A-F]{2}$|^([0-9A-F]{2}:){9}[0-9A-F]{2}$"
          );
      }

      allow read: if isAdmin();
      allow create, update: if isAdmin() && validCredential();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "type", "uid", "userId", "userEmail", "status", "createdAt"
        ])
        && request.resource.data.type == "theft"
        && request.resource.data.status == "pending"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid is string
        && request.resource.data.uid.matches("^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$")
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "user"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cardUid
          == request.resource.data.uid;

      allow read: if signedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
